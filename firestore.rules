rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin authorization check - bootstraps current developer email and trusted admins collection
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sadhinultra@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User entity validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['super_admin', 'admin', 'editor', 'user'];
    }

    // Post entity validation
    function isValidPost(data) {
      return data.keys().hasAll(['title', 'slug', 'content', 'status']) &&
             data.title is string && data.title.size() <= 500 &&
             data.slug is string && data.slug.size() <= 300 &&
             data.content is string && data.content.size() <= 100000 &&
             data.status in ['draft', 'published', 'scheduled', 'archived'];
    }

    // Comment entity validation
    function isValidComment(data) {
      return data.keys().hasAll(['postId', 'authorName', 'content', 'status']) &&
             data.postId is string && data.postId.size() <= 128 &&
             data.authorName is string && data.authorName.size() <= 100 &&
             data.content is string && data.content.size() <= 5000 &&
             data.status in ['approved', 'pending', 'spam'];
    }

    // Users Collection (RBAC & User Control)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      // Creating account - standard users cannot grant themselves admin/editor roles
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().role == 'user' || isAdmin()
      );

      // Updating account - regular users can only edit profile fields; admins can change roles
      allow update: if (
        isOwner(userId) && isValidUser(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
      ) || (
        isAdmin() && isValidUser(incoming())
      );

      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Posts Collection
    match /posts/{postId} {
      allow get: if resource.data.status == 'published' || isAdmin();
      allow list: if isAdmin() || (resource.data.status == 'published');
      allow create, update, delete: if isAdmin() && isValidPost(incoming());
    }

    // Comments Collection
    match /comments/{commentId} {
      allow get: if resource.data.status == 'approved' || isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (resource.data.status == 'approved');
      allow create: if isValidComment(incoming()) && (
        !isSignedIn() || incoming().userId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt'])
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
